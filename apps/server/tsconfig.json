{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "ES2022",

    "strict": true,

    "sourceMap": true,

    "declaration": false,

    "exactOptionalPropertyTypes": true,

    "noUncheckedIndexedAccess": true,

    "verbatimModuleSyntax": true,

    "isolatedModules": true,

    "noUncheckedSideEffectImports": true,

    "moduleDetection": "force",

    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "generated",
    "dist",
    "node_modules",
    "prisma.config.ts",
    "**/*.test.ts"
  ]
}